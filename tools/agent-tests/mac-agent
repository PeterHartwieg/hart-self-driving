#!/usr/bin/env python3
"""Manually control the local Mac fallback rig. Never contacts or starts the Windows PC."""
import argparse
import hashlib
import json
import os
import re
import signal
import shutil
import subprocess
import sys
import time
from mac_common import *
from ftlib.bridge import Bridge,BridgeError

def process():
    receipt=ROOT/'run.json'
    if not receipt.exists():return None
    r=json.loads(receipt.read_text());pid=r['pid']
    ps=subprocess.run(['ps','-ww','-p',str(pid),'-o','stat=','-o','lstart=','-o','comm='],text=True,capture_output=True)
    if ps.returncode:return None
    state,current=ps.stdout.strip().split(None,1)
    if state.startswith('Z'):return None
    if current!=r['identity']:raise RuntimeError('PID identity changed; refusing to control it')
    if not current.endswith(str(EXE)):raise RuntimeError('Executable identity mismatch')
    return r

def health():
    h=Bridge(URL).health();identity(h)
    r=process()
    if r is None or h['agent_instance']['pid']!=r['pid']:raise RuntimeError('Bridge PID does not match the launcher receipt')
    return h

def wait_stopped(seconds):
    deadline=time.monotonic()+seconds
    while time.monotonic()<deadline:
        try:
            if not process():return True
        except RuntimeError:
            # macOS can replace comm with the short name during process teardown.
            # Wait for disappearance; never signal a process whose identity changed.
            pass
        time.sleep(.3)
    return False

def call(cmd,args=None):
    health()
    b=Bridge(URL);identity(b.health())
    return b.call(cmd,args or {})

def verify():
    plain(ROOT);plain(PROFILE)
    record=json.loads((ROOT/'install.json').read_text())
    if record['instance']!='agentmac' or record['app']!=str(APP) or record['profile']!=str(PROFILE):raise RuntimeError('Unexpected Mac installation')
    for name,expected in record['files'].items():
        if hashlib.sha256(Path(name).read_bytes()).hexdigest()!=expected:raise RuntimeError('Installed file changed: '+name)

def resources():
    free=shutil.disk_usage(ROOT if ROOT.exists() else OUT).free
    text=subprocess.check_output(['memory_pressure','-Q'],text=True)
    match=re.search(r'System-wide memory free percentage: (\d+)%',text)
    if not match:raise RuntimeError('Cannot determine current memory headroom')
    pressure=int(match.group(1))
    return {'disk_free_gib':round(free/1024**3,1),'memory_free_percent':pressure}

def start(mode='headless'):
    with lifecycle():
        if process():raise RuntimeError('Mac rig is already running')
        # An unknown process at this exact executable also blocks startup (e.g. lost receipt).
        listing=subprocess.check_output(['ps','-axo','comm='],text=True)
        if str(EXE) in listing.splitlines():raise RuntimeError('Untracked Mac rig process exists; inspect it before starting')
        import socket
        with socket.socket() as sock:
            sock.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1)
            sock.bind(('127.0.0.1',28330))
            sock.listen(1)
        r=resources()
        if r['disk_free_gib']<12 or r['memory_free_percent']<20:raise RuntimeError('Insufficient Mac resource headroom: '+json.dumps(r))
        verify()
        args=[str(EXE),'-agent-tests','-disable-force-steam','-console','-foodtrucks-test','-drivenrides-test','-batchmode','-screen-fullscreen','0','-screen-width','960','-screen-height','540','-screen-quality','Low','-job-worker-count','2','-logFile',str(ROOT/'Player-agent.log')]
        if mode=='headless':args.append('-nographics')
        with open(ROOT/'launcher.log','ab') as output:
            p=subprocess.Popen(args,cwd=EXE.parent,stdin=subprocess.DEVNULL,stdout=output,stderr=output,start_new_session=True)
        ps=subprocess.check_output(['ps','-ww','-p',str(p.pid),'-o','lstart=','-o','comm='],text=True).strip()
        if not ps.endswith(str(EXE)):raise RuntimeError('New process identity was not as expected')
        (ROOT/'run.json').write_text(json.dumps({'pid':p.pid,'identity':ps,'exe':str(EXE),'mode':mode},indent=2))
        os.setpriority(os.PRIO_PROCESS,p.pid,10)
        subprocess.Popen(['/usr/bin/caffeinate','-i','-w',str(p.pid)],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)
    deadline=time.monotonic()+300
    while time.monotonic()<deadline:
        if not process():raise RuntimeError('Mac rig exited during startup; inspect '+str(ROOT/'Player-agent.log'))
        try:return health()
        except (BridgeError,ConnectionError):time.sleep(1)
    raise RuntimeError('Mac bridge did not become ready within 300s; inspect status/log before retrying')

def stop(force=False):
    control('assert')
    r=process()
    if not r:return {'stopped':True}
    if not force:
        health()
        try:call('quit')
        except BridgeError:
            if process():raise
        if wait_stopped(40):return {'stopped':True}
        raise RuntimeError('Mac rig still running; inspect log or use stop --force')
    with lifecycle('terminate'):
        r=process()
        if r:os.kill(r['pid'],signal.SIGTERM)
        for _ in range(20):
            if not process():return {'stopped':True,'forced':True}
            time.sleep(.2)
        if process():
            os.kill(r['pid'],signal.SIGKILL)
            for _ in range(20):
                if not process():break
                time.sleep(.1)
    return {'stopped':not bool(process()),'forced':True}

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action',choices=['status','health','resources','start','stop','call','lock','log'])
    parser.add_argument('command',nargs='?');parser.add_argument('arguments',nargs='?',default='{}')
    parser.add_argument('--owner');parser.add_argument('--purpose',default='Mac fallback test')
    parser.add_argument('--mode',choices=['background','headless'],default='headless');parser.add_argument('--force',action='store_true')
    a=parser.parse_args()
    if a.owner:os.environ['BA_LOCK_OWNER']=a.owner
    if a.action=='lock':
        op=a.command or 'status'
        if op not in ('status','acquire','release'):parser.error('lock op must be status, acquire or release')
        result=control(op,purpose=a.purpose)
    elif a.action=='resources':result=resources()
    elif a.action=='start':result=start(a.mode)
    elif a.action=='stop':result=stop(a.force)
    elif a.action=='health':result=health()
    elif a.action=='status':
        r=process();result={'installed':(ROOT/'install.json').exists(),'running':bool(r),'process':r,'lock':control('status')}
        if r:
            try:result['health']=health()
            except BridgeError as e:result['bridge_error']=str(e)
    elif a.action=='call':
        if not a.command:parser.error('call requires a command')
        result=call(a.command,json.loads(a.arguments))
    else:
        print('\n'.join((ROOT/'Player-agent.log').read_text(errors='replace').splitlines()[-90:]));return
    print(json.dumps(result,indent=2))
if __name__=='__main__':
    try:main()
    except (RuntimeError,ValueError,OSError,subprocess.SubprocessError) as e:print(str(e),file=sys.stderr);sys.exit(1)
