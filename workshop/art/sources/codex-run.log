+import hashlib
+import json
+import shutil
+from pathlib import Path
+
+from PIL import Image, __version__ as pillow_version
+
+root = Path('/Users/peterhartwieg/Coding_Projects/big-ambitions-driven-rides/workshop/art')
+manifest = json.loads(Path('/private/tmp/driven-rides-generation-manifest.json').read_text())
+rows = []
+details = []
+visual_checks = {
+    'hero-wide.png': 'Visual review: yellow taxi in right half, heading up/right; distant traffic at red lights; empty road ahead; left 40% dark and calm. No visible lettering, HUD or watermark. New buildings/composition rather than the reference screenshot.',
+    'hero-square.png': 'Visual review: yellow taxi lower centre; empty avenue ahead to a red-light junction; tower tops and sky occupy the upper region. No visible lettering, HUD or watermark. Square recomposition with matching dusk palette.',
+    'taxi.png': 'Visual review: yellow taxi sedan, blank roof sign/plate, front three-quarter view from above; full vehicle within canvas. Inspected composited on a light grey background: clean silhouette, no opaque backdrop or visible halo.',
+    'limo.png': 'Visual review: black stretch limousine with clearly elongated body, blank plate, front three-quarter view from above; full vehicle within canvas. Inspected composited on a light grey background: clean silhouette, no opaque backdrop or visible halo.',
+    'own-car.png': 'Visual review: deep green compact five-door hatchback, short rear overhang, blank plate, front three-quarter view from above; full vehicle within canvas. Inspected composited on a light grey background: clean silhouette, no opaque backdrop or visible halo.',
+}
+
+for spec in manifest:
+    name = spec['filename']
+    destination = root / name
+    attempts = spec['attempts']
+    selected = Path(attempts[-1]['path'])
+    with Image.open(selected) as original:
+        original.load()
+        native_size = original.size
+        if name == 'hero-wide.png':
+            original.resize((1920, 1080), Image.Resampling.LANCZOS).save(destination, format='PNG')
+            processing = f'Pillow LANCZOS resize from {native_size[0]}×{native_size[1]} to 1920×1080 to meet the requested minimum and exact 16:9 ratio. This is an upscale, not additional generated detail.'
+        else:
+            shutil.copy2(selected, destination)
+            processing = 'Copied the selected tool output unchanged; no resizing or background removal.'
+    with Image.open(destination) as check:
+        check.verify()
+    with Image.open(destination) as check:
+        check.load()
+        w, h = check.size
+        mode = check.mode
+        assert check.format == 'PNG'
+        if spec['transparent']:
+            assert mode == 'RGBA'
+            assert w >= 1536 and h >= 1024
+            alpha = check.getchannel('A')
+            corners = [alpha.getpixel(p) for p in [(0, 0), (w-1, 0), (0, h-1), (w-1, h-1)]]
+            assert corners == [0, 0, 0, 0]
+            histogram = alpha.histogram()
+            assert histogram[0] > 0 and sum(histogram[1:]) > 0
+            alpha_note = f'{corners}; alpha range {alpha.getextrema()}, {histogram[0]:,} fully transparent pixels'
+            alpha_detail = f'Corner alpha (top-left, top-right, bottom-left, bottom-right): `{corners}`. Alpha extrema: `{alpha.getextrema()}`. Fully transparent pixels: `{histogram[0]:,}` / `{w*h:,}`. Alpha was supplied by the tool and preserved; background removal was unnecessary. The tool\'s maximum alpha is 254 (near-opaque), retained unchanged.'
+        else:
+            if name == 'hero-wide.png':
+                assert w >= 1920 and h >= 1080 and w * 9 == h * 16
+            else:
+                assert w == h and w >= 1024
+            alpha_note = 'N/A (opaque hero)'
+            alpha_detail = 'Opaque hero; no cutout-alpha requirement.'
+    sha = hashlib.sha256(destination.read_bytes()).hexdigest()
+    rows.append(f'| {name} | {mode} | {w}×{h} | {len(attempts)-1} | {alpha_note} | PASS |')
+    detail = [f'## {name}', '', f'Final file: `../{name}`. Native selected output: {native_size[0]}×{native_size[1]}. Final PNG: {mode}, {w}×{h}.', '', f'Generations: {len(attempts)}; retries: {len(attempts)-1}. ' + (f'Retry reason: {spec["retryReason"]}' if spec['retryReason'] else 'No retry needed.'), '', processing, '', alpha_detail, '', visual_checks[name], '', f'SHA-256: `{sha}`.', '']
+    for i, attempt in enumerate(attempts, 1):
+        with Image.open(attempt['path']) as generated:
+            output_info = f'{generated.mode}, {generated.width}×{generated.height}'
+        label = 'selected final' if i == len(attempts) else 'rejected'
+        detail.extend([f'### Generation {i} ({label})', '', f'Tool output: {output_info}. Source: `{attempt["path"]}`.', '', 'Exact prompt sent to the built-in tool:', '', '```text', attempt['prompt'], '```', ''])
